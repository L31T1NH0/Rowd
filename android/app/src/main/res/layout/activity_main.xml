<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rowd" android:textAppearance="?attr/textAppearanceHeadlineLarge" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Seus arquivos, entre seus dispositivos." android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Vamos conectar sua pasta" android:textAppearance="?attr/textAppearanceTitleLarge" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp" android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Escolha uma pasta e importe o convite gerado no PC. Os dois aparelhos precisam estar na mesma rede." android:textAppearance="?attr/textAppearanceBodyMedium" android:textIsSelectable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Raiz Rowd no celular" android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
        <TextView android:id="@+id/folderLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Nenhuma pasta escolhida" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.button.MaterialButton android:id="@+id/chooseFolder" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="Escolher raiz Rowd" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Seu PC" android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
        <TextView android:id="@+id/peerLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ainda não pareado" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.button.MaterialButton android:id="@+id/scanQr" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="Parear por QR" />
        <com.google.android.material.button.MaterialButton android:id="@+id/importInvite" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="Importar convite do PC" />
        <com.google.android.material.button.MaterialButton android:id="@+id/changeAddress" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Alterar endereço do PC" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Shares gerenciados pelo PC" android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
        <TextView android:id="@+id/sharesLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Adicione Shares pelo PC." android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.button.MaterialButton android:id="@+id/requestShare" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="Solicitar Share" />
        <com.google.android.material.button.MaterialButton android:id="@+id/syncNow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="28dp" android:text="Sincronizar agora" />
        <com.google.android.material.button.MaterialButton android:id="@+id/automatic" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="Iniciar sincronização automática" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="O modo automático usa avisos do provedor e verificação periódica de 5 segundos quando necessário. O Android pode interrompê-lo. Exclusões não são propagadas." android:textAppearance="?attr/textAppearanceBodySmall" />
        <com.google.android.material.button.MaterialButton android:id="@+id/manageRecovery" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="20dp" android:text="Revisar versões recuperáveis" />
        <com.google.android.material.button.MaterialButton android:id="@+id/exportRecovery" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="20dp" android:text="Exportar cópias de recuperação" />
    </LinearLayout>
</ScrollView>
